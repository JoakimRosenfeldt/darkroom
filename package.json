{
  "name": "darkroom",
  "version": "0.1.0",
  "private": true,
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "node electron/build.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && npm run build:electron && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:start": "npm run build:electron && electron .",
    "test:develop:electron": "npm run build:electron && node scripts/develop-workflow-smoke.mjs",
    "test:catalog-worker:worker": "npm run build:electron && cross-env ELECTRON_RUN_AS_NODE=1 electron --no-warnings --experimental-strip-types scripts/catalog-worker-smoke.mts electron-dist/catalog-worker.js",
    "test:catalog-worker:electron": "npm run build:electron && node --no-warnings --experimental-strip-types scripts/catalog-worker-smoke.mts --app",
    "dist": "npm run build && node scripts/package-release.mjs",
    "pretest": "node native/file-transaction-helper/build.mjs",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mts",
    "lint": "eslint",
    "postinstall": "node scripts/patch-libraw.mjs && node scripts/ensure-electron.mjs",
    "build:renderer": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.3",
    "exifr": "^7.1.3",
    "libraw-wasm": "^1.6.0",
    "onnxruntime-web": "1.27.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.18.3",
    "sharp": "^0.34.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^14.0.0",
    "playwright": "^1.61.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.61.1",
    "vite": "^8.2.2",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "postcss": "8.5.16"
  },
  "build": {
    "appId": "com.darkroom.app",
    "productName": "Darkroom",
    "files": [
      "electron-dist/**/*",
      "out/**/*",
      "resources/icon/darkroom.png",
      "package.json",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*"
    ],
    "asarUnpack": [
      "electron-dist/file-transaction-helper-*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "resources/icon/darkroom.icns",
      "category": "public.app-category.photography",
      "extraResources": [
        {
          "from": "${env.DARKROOM_NEF_SDK_FROM}/spike/DarkroomNefSpike.app/Contents",
          "to": "nikon-nef-decoder",
          "filter": [
            "MacOS/nikon-nef-decoder",
            "Frameworks/**/*",
            "Resources/**/*"
          ]
        },
        {
          "from": "${env.DARKROOM_NEF_SDK_FROM}/Image SDK/Library/Mac/Doc/Third Party Legal Notices.rtf",
          "to": "nikon-nef-decoder/Third Party Legal Notices.rtf"
        },
        {
          "from": "${env.DARKROOM_NEF_SDK_FROM}/spike/DarkroomNefSpike.app/Contents/Resources/prm.bin",
          "to": "Contents/Resources/prm.bin"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon/darkroom.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icon/darkroom.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
