{
  "name": "darkroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tauri build --no-bundle",
    "dist": "node scripts/package-release.mjs",
    "pretest": "node native/file-transaction-helper/build.mjs",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mts",
    "lint": "eslint",
    "postinstall": "node scripts/patch-libraw.mjs",
    "build:renderer": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/package-release.mjs",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "desktop:dev": "tauri dev",
    "start": "node scripts/start-desktop.mjs",
    "build:backend": "cargo build --manifest-path src-tauri/Cargo.toml --features diagnostics --bin darkroom-backend --locked",
    "test:develop:desktop": "cargo build --manifest-path src-tauri/Cargo.toml --features diagnostics --bin darkroom --locked && node scripts/develop-workflow-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/api": "^2.11.1",
    "libraw-wasm": "^1.6.0",
    "onnxruntime-web": "1.27.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.18.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^14.0.0",
    "playwright": "^1.61.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.61.1",
    "vite": "^8.2.2",
    "sharp": "^0.34.5",
    "exifr": "^7.1.3"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
